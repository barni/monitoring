## Email config, example for GMAIL
spring.mail.host=smtp.gmail.com
spring.mail.port=587
spring.mail.username=<email>@gmail.com
spring.mail.password=<password>
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true
## Ohne Timeouts wartet JavaMail unbegrenzt. Ein haengender Mailserver wuerde
## sonst den Alarm-Scheduler dauerhaft blockieren.
spring.mail.properties.mail.smtp.connectiontimeout=5000
spring.mail.properties.mail.smtp.timeout=5000
spring.mail.properties.mail.smtp.writetimeout=5000

## Login. Die Anwendung authentifiziert selbst (HTTP Basic), der Reverse Proxy
## liefert nur HTTPS. Ohne diese beiden Werte erzeugt Spring Boot beim Start ein
## zufaelliges Passwort und schreibt es ins Log.
##
## Frueher stand hier zusaetzlich eine spring.autoconfigure.exclude-Zeile fuer
## SecurityAutoConfiguration. Die hat den Login nicht eingerichtet, sondern
## abgeschaltet: Saemtliche Endpunkte waren ohne Anmeldung erreichbar.
##
## Das Passwort darf als Klartext stehen oder als Hash mit Algorithmus-Praefix,
## z.B. spring.security.user.password={bcrypt}$2a$10$... - der Hash ist
## vorzuziehen, weil die Datei sonst das Klartextpasswort auf der Platte haelt.
spring.security.user.name=<user>
spring.security.user.password=<password>

## Listen only on localhost, use reverse proxy for https
server.address=127.0.0.1
## Client-IP aus X-Forwarded-For uebernehmen, damit in den Logs nicht bei jedem
## Request 127.0.0.1 steht. NATIVE wertet den Header nur aus, wenn die Verbindung
## von einem internen Proxy kommt - hier also vom lokalen Reverse Proxy.
server.forward-headers-strategy=NATIVE

## Monitoring
## Empfaenger der Alarm-Mails.
monitoring.alert-recipient=<empfaenger>@example.com
## Obergrenze gleichzeitig ueberwachter Dienste. Verhindert, dass beliebig viele
## Namen registriert und dadurch beliebig viele Alarm-Mails ausgeloest werden.
monitoring.max-services=100
## Frist in Sekunden, nach der ein ausbleibender Heartbeat einen Alarm ausloest.
monitoring.timeout-seconds=120
## Optionale Positivliste, kommasepariert. Ist sie gesetzt, werden Heartbeats
## anderer Namen mit 400 abgewiesen. Leer = jeder gueltige Name bis max-services.
monitoring.known-services=
